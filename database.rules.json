{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJ-KM-NP-Z2-9]{4}$/)",
        ".read": "auth != null",
        "config": {
          ".write": "auth != null && !data.exists()",
          "durationSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
          },
          "createdAt": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        },
        "host": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid || !newData.exists())",
          ".validate": "newData.hasChildren(['uid','name','online','reps','ready'])",
          "uid": {
            ".validate": "newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "reps": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
          },
          "ready": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "leftAt": {
            ".validate": "newData.val() == now || newData.val() == null"
          }
        },
        "guest": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid || !newData.exists())",
          ".validate": "newData.hasChildren(['uid','name','online','reps','ready'])",
          "uid": {
            ".validate": "newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "reps": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
          },
          "ready": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "leftAt": {
            ".validate": "newData.val() == now || newData.val() == null"
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').child('uid').val() == auth.uid",
          ".validate": "newData.val() == 'waiting' || newData.val() == 'counting' || newData.val() == 'live' || newData.val() == 'done'"
        },
        "startAt": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').child('uid').val() == auth.uid",
          ".validate": "newData.val() == now"
        },
        "result": {
          ".write": "auth != null && !data.exists() && (root.child('rooms').child($code).child('host').child('uid').val() == auth.uid || root.child('rooms').child($code).child('guest').child('uid').val() == auth.uid)",
          ".validate": "newData.hasChildren(['hostReps','guestReps','winner'])",
          "hostReps": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
          },
          "guestReps": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 == 0"
          },
          "winner": {
            ".validate": "newData.val() == 'host' || newData.val() == 'guest' || newData.val() == 'draw'"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        },
        "countdownSec": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').child('uid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        }
      }
    }
  }
}
